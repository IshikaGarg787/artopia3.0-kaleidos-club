# 1. Copy this file and rename the copy to  .env   (the dot at the start is important)
# 2. Fill in the values. NEVER share or upload the .env file.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Replace <password> and keep the database name "artopia3".
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/artopia3?retryWrites=true&w=majority

# Port for the API (the website proxies to it during development)
PORT=5001

# true = accept registrations, false = closed
REGISTRATION_OPEN=true

# Secret key to download registrations: /api/admin/registrations?key=THIS_VALUE&format=csv
# Use a long random value. Leave empty to disable the export.
ADMIN_KEY=

# Only needed when the website and API are on DIFFERENT domains (comma separated). Leave empty for local use.
CLIENT_ORIGIN=
